# --- Servidor ---
# src/main.ts: puerto HTTP (por defecto 3000 si falta)
PORT=3000

# --- CORS ---
# src/middleware/cors.middleware.ts: origen permitido (por defecto http://localhost:4321)
FRONTEND_ORIGIN=http://localhost:4321

# --- JWT ---
# src/utils/jwt.utils.ts: obligatorias, la app no arranca sin ellas
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# --- Cloudinary ---
# src/services/upload.services.ts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- Base de datos ---
# prisma/schema.prisma (env("DATABASE_URL")); no se lee con process.env en src/
DATABASE_URL=
