generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  bio       String?
  imageUrl  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  posts    Post[]
  projects Project[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  slug      String   @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  author User @relation(fields: [userId], references: [id])

  comentarios Comentario[]
}

enum EstadoComentario {
  PENDIENTE
  PUBLICADO
}

model Comentario {
  id        Int              @id @default(autoincrement())
  postId    Int
  nombre    String           @db.VarChar(80)
  correo    String?          @db.VarChar(254)
  cuerpo    String
  estado    EstadoComentario @default(PENDIENTE)
  ipHash    String?          @db.VarChar(64)
  createdAt DateTime         @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, estado])
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  repoUrl     String?
  liveUrl     String?
  createdAt   DateTime @default(now())

  userId Int
  owner  User @relation(fields: [userId], references: [id])
}
